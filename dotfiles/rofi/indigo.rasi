/* Indigo Magic menu.
 * Rofi border-color is a single color, so the frame is the dark bevel
 * (#625d52) rather than a four-sided Motif highlight.
 * Face is the Indigo frame beige. The entry is a content well; the selected
 * row uses the desktop blue #202452 with the content highlight #e6e6e6.
 */

* {
    font: "Nimbus Sans 12";
    background-color: #a49d83;
    text-color: #000000;
    border-radius: 0px;
    spacing: 0px;
}

window {
    location: center;
    anchor: center;
    width: 480px;
    border: 2px solid;
    border-color: #625d52;
    background-color: #a49d83;
    padding: 6px;
}

mainbox {
    border: 0px;
    padding: 0px;
    spacing: 4px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    border: 2px solid;
    border-color: #737173;
    background-color: #bdc2bd;
    padding: 4px;
    spacing: 6px;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: #000000;
}

entry {
    background-color: transparent;
    text-color: #000000;
    placeholder: "Run";
    placeholder-color: #737173;
}

listview {
    border: 0px;
    padding: 0px;
    background-color: #a49d83;
    lines: 8;
    fixed-height: false;
    scrollbar: false;
}

element {
    border: 0px;
    padding: 2px 6px;
    background-color: transparent;
    text-color: #000000;
}

element selected {
    background-color: #202452;
    text-color: #e6e6e6;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
