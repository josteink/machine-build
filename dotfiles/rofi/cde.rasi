/* CDE Crimson menu.
 * Rofi border-color is a single color, so the frame is the dark bevel
 * (#465663) rather than a four-sided Motif highlight.
 * Face is color set 6. The entry and the selected row are color set 4.
 */

* {
    font: "DejaVu Sans 12";
    background-color: #8dadc7;
    text-color: #000000;
    border-radius: 0px;
    spacing: 0px;
}

window {
    location: center;
    anchor: center;
    width: 480px;
    border: 2px solid;
    border-color: #465663;
    background-color: #8dadc7;
    padding: 6px;
}

mainbox {
    border: 0px;
    padding: 0px;
    spacing: 4px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    border: 2px solid;
    border-color: #465663;
    background-color: #fff7e9;
    padding: 4px;
    spacing: 6px;
    children: [ "prompt", "entry" ];
}

prompt {
    background-color: transparent;
    text-color: #000000;
}

entry {
    background-color: transparent;
    text-color: #000000;
    placeholder: "Run";
    placeholder-color: #465663;
}

listview {
    border: 0px;
    padding: 0px;
    background-color: #8dadc7;
    lines: 8;
    fixed-height: false;
    scrollbar: false;
}

element {
    border: 0px;
    padding: 2px 6px;
    background-color: transparent;
    text-color: #000000;
}

element selected {
    background-color: #fff7e9;
    text-color: #000000;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
